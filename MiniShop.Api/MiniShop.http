POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "email": "kupac@minishop.rs", "password": "Lozinka123!" }

###
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{ "email": "kupac2@minishop.rs", "password": "Lozinka123!", "fullName": "Drugi Kupac" }

###
