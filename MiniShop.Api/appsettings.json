{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=MiniShop;User Id=sa;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Catalog": {
    "PageSize": 20,
    "CacheSeconds": 60
  },
  "Rates": {
    "BaseUrl": "https://api.kurs.example.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://shop.minishop.rs"
    ]
  },
  "Seed": {
    "AdminEmail": "admin@minishop.rs"
  },
  "Jwt": {
    "Issuer": "https://localhost:7150",
    "Audience": "minishop-spa",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Seq": {
    "Url": "http://localhost:5341"
  }
}