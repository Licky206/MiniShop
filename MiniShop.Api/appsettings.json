{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=MiniShop;User Id=sa;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Catalog": {
    "PageSize": 20,
    "CacheSeconds": 60
  },
  "Rates": {
    "BaseUrl": "https://api.kurs.example.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://shop.minishop.rs"
    ]
  },
  "Seed": {
    "AdminEmail": "admin@minishop.rs"
  },
  "Jwt": {
    "Issuer": "https://localhost:7150",
    "Audience": "minishop-spa",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}